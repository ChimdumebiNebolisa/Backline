{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://backline.dev/schemas/summary-v1.schema.json",
  "title": "Backline summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "status", "exit_code", "started_at", "finished_at", "config", "base", "candidate", "environment", "component_images", "component_endpoints", "rollback_mode", "verdicts", "controls", "stages", "scenarios", "operational_errors", "artifacts", "cleanup", "warnings"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^bl-"},
    "status": {"enum": ["PASS", "FAIL", "INCONCLUSIVE", "ERROR"]},
    "exit_code": {"enum": [0, 10, 20, 21, 22, 23, 24, 25]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "source_sha", "sha256"],
      "properties": {"path": {"type": "string"}, "source_sha": {"type": "string"}, "sha256": {"type": "string"}}
    },
    "base": {"$ref": "#/$defs/revision"},
    "candidate": {"$ref": "#/$defs/revision"},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["env_file_external", "selected_services", "networks", "shared_service_images"],
      "properties": {
        "env_file_display": {"type": "string"}, "env_file_external": {"type": "boolean"}, "env_file_sha256": {"type": "string"},
        "docker_context": {"type": "string"}, "docker_version": {"type": "string"}, "compose_version": {"type": "string"},
        "selected_services": {"type": "array", "items": {"type": "string"}},
        "networks": {"type": "array", "items": {"type": "string"}},
        "shared_service_images": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "component_images": {"type": "object", "additionalProperties": {"type": "string"}},
    "component_endpoints": {"type": "object", "additionalProperties": {"type": "string"}},
    "rollback_mode": {"enum": ["RAW", "PREPARED"]},
    "verdicts": {
      "type": "object", "additionalProperties": false, "required": ["mixed_version", "rollback"],
      "properties": {"mixed_version": {"$ref": "#/$defs/verdict"}, "rollback": {"$ref": "#/$defs/verdict"}}
    },
    "controls": {
      "type": "object", "additionalProperties": false,
      "required": ["base_after_transition", "candidate_before_coexistence", "base_with_candidate_running"],
      "properties": {
        "base_after_transition": {"$ref": "#/$defs/stage_outcome"},
        "candidate_before_coexistence": {"$ref": "#/$defs/stage_outcome"},
        "base_with_candidate_running": {"$ref": "#/$defs/stage_outcome"}
      }
    },
    "stages": {"type": "array", "items": {"$ref": "#/$defs/stage"}},
    "scenarios": {"type": "array", "items": {"$ref": "#/$defs/step"}},
    "operational_errors": {"type": "array", "items": {"$ref": "#/$defs/operational_error"}},
    "artifacts": {"type": "object"},
    "cleanup": {
      "type": "object", "additionalProperties": false, "required": ["status", "reason_codes", "duration_ms"],
      "properties": {
        "status": {"$ref": "#/$defs/stage_outcome"},
        "reason_codes": {"type": "array", "items": {"$ref": "#/$defs/reason_code"}},
        "remaining": {"type": "array", "items": {"type": "string"}},
        "duration_ms": {"type": "integer"}
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "reason_code": {"enum": ["NONE", "CONFIG_INVALID", "SAFETY_POLICY_BLOCKED", "PREREQUISITE_UNAVAILABLE", "BUILD_FAILED", "SHARED_ENVIRONMENT_FAILED", "BOOTSTRAP_FAILED", "BASE_STARTUP_FAILED", "BASELINE_FAILED", "TRANSITION_HOOK_FAILED", "BASE_LOST_READINESS", "BASE_AFTER_TRANSITION_CONTROL_FAILED", "CANDIDATE_STARTUP_FAILED", "CANDIDATE_CONTROL_FAILED", "BASE_WITH_CANDIDATE_CONTROL_FAILED", "COEXISTENCE_SCENARIO_FAILED", "REQUIRED_COMPONENT_EXITED", "COMMAND_LAUNCH_FAILED", "CANDIDATE_ONLY_HOOK_FAILED", "CANDIDATE_TRAFFIC_FAILED", "CANDIDATE_TRAFFIC_INCOMPLETE", "NO_CANDIDATE_MUTATION_SCENARIO_RAN", "ROLLBACK_HOOK_FAILED", "BASE_RESTART_FAILED", "ROLLBACK_SCENARIO_FAILED", "INTERRUPTED", "ORCHESTRATION_ERROR", "INTERNAL_ERROR", "CLEANUP_FAILED"]},
    "stage_outcome": {"enum": ["PASS", "FAIL", "ERROR", "SKIPPED", "INCOMPLETE"]},
    "revision": {
      "type": "object", "additionalProperties": false, "required": ["ref", "sha"],
      "properties": {"ref": {"type": "string"}, "sha": {"type": "string"}}
    },
    "verdict": {
      "type": "object", "additionalProperties": false, "required": ["status", "reason_codes"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "INCONCLUSIVE"]},
        "reason_codes": {"type": "array", "items": {"$ref": "#/$defs/reason_code"}},
        "message": {"type": "string"}
      }
    },
    "stage": {
      "type": "object", "additionalProperties": false, "required": ["name", "outcome", "started_at", "finished_at", "termination_attempted", "termination_succeeded", "truncated"],
      "properties": {
        "name": {"type": "string"}, "outcome": {"$ref": "#/$defs/stage_outcome"},
        "reason_codes": {"type": "array", "items": {"$ref": "#/$defs/reason_code"}},
        "started_at": {"type": "string", "format": "date-time"}, "finished_at": {"type": "string", "format": "date-time"},
        "duration_ms": {"type": "integer"}, "message": {"type": "string"}, "revision": {"type": "string"},
        "runner": {"type": "string"}, "command": {"type": "array", "items": {"type": "string"}},
        "exit_code": {"type": "integer"}, "log_path": {"type": "string"}, "signal": {"type": "string"},
        "termination_attempted": {"type": "boolean"}, "termination_succeeded": {"type": "boolean"}, "truncated": {"type": "boolean"}
      }
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["stage", "scenario", "step", "outcome", "reason_code", "started_at", "finished_at", "timed_out", "termination_attempted", "termination_succeeded", "duration_ms"],
      "properties": {
        "stage": {"type": "string"}, "scenario": {"type": "string"}, "step": {"type": "string"}, "target": {"type": "string"},
        "outcome": {"$ref": "#/$defs/stage_outcome"}, "reason_code": {"$ref": "#/$defs/reason_code"},
        "started_at": {"type": "string", "format": "date-time"}, "finished_at": {"type": "string", "format": "date-time"},
        "exit_code": {"type": "integer"}, "timed_out": {"type": "boolean"}, "signal": {"type": "string"},
        "termination_attempted": {"type": "boolean"}, "termination_succeeded": {"type": "boolean"},
        "duration_ms": {"type": "integer"}, "log_path": {"type": "string"}, "message": {"type": "string"}, "truncated": {"type": "boolean"},
        "command": {"type": "array", "items": {"type": "string"}}, "cwd_revision": {"type": "string"}, "revision_sha": {"type": "string"}, "working_directory": {"type": "string"}
      }
    },
    "operational_error": {
      "type": "object", "additionalProperties": false, "required": ["reason_code", "message"],
      "properties": {"stage": {"type": "string"}, "reason_code": {"$ref": "#/$defs/reason_code"}, "message": {"type": "string"}}
    }
  }
}
