{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://backline.dev/schemas/event-v1.schema.json",
  "title": "Backline event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["timestamp", "type", "run_id", "details"],
  "properties": {
    "timestamp": {"type": "string", "format": "date-time"},
    "type": {"type": "string", "minLength": 1},
    "stage": {"type": "string"},
    "run_id": {"type": "string", "pattern": "^bl-"},
    "details": {"type": "object"}
  }
}
